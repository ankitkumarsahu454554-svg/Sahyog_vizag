# ============================================================
# SahyogAI Vizag — Environment Configuration
# Powered by Antigravity AI Engine
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# For local development:
MONGODB_URI=mongodb://localhost:27017/sahyogai
# For MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/sahyogai?retryWrites=true&w=majority

# ---- JWT Authentication ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=7d

# ---- Gemini AI (Google AI Studio) ----
# Get your key at: https://aistudio.google.com/
# Leave blank to use the Antigravity deterministic rule-based fallback only.
GEMINI_API_KEY=

# ---- Hugging Face AI (Inference API for Whisper ASR) ----
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ---- CORS (comma-separated list of allowed frontend origins) ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ---- Demo Mode ----
# When true, the /api/demo/reset endpoint is available.
DEMO_MODE=true
